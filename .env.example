# Copy to .env and adjust. Every value here has a working default for local dev.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=dev                          # dev | prod
LOG_LEVEL=INFO
LOG_JSON=false                       # true = JSON logs (for log aggregators)

# Metadata DB (datasources, models, history). SQLite for dev, Postgres in docker.
APP_DB_URL=sqlite:///./data/nl2sql_app.db
# APP_DB_URL=postgresql+psycopg://nl2sql:nl2sql@localhost:5432/nl2sql_app

# Encrypts API keys + datasource URLs at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose it, stored keys must be re-entered.
SECRET_KEY=

# Admin API key for the HTTP API (comma-separated for several). Empty = no auth (dev only).
API_KEYS=

# ── LLM bootstrap (OPTIONAL) ─────────────────────────────────────────────────
# Providers/models are normally added from the UI. If these are set AND no provider
# exists yet, the app seeds one on startup and assigns it to every role.
# provider types: ollama | openai_compatible | openai | anthropic | gemini | groq |
#                 mistral | deepseek | openrouter | azure | bedrock
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=
# Example — fully local:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_BASE=http://localhost:11434

# Embeddings: fastembed (local, no key) | none (BM25-only) | any provider type above
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# ── Vector store ─────────────────────────────────────────────────────────────
VECTOR_BACKEND=memory                # memory | qdrant
QDRANT_URL=http://localhost:6333

# ── Query safety ─────────────────────────────────────────────────────────────
SQL_QUERY_TIMEOUT_S=30
SQL_MAX_ROWS=500
